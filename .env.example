# Добавь эти переменные в Vercel → Settings → Environment Variables

TG_BOT_TOKEN=your_telegram_bot_token
# ВАЖНО: нужен для верификации Telegram initData (безопасность)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
APP_URL=https://your-domain.vercel.app
FRONTEND_URL=https://your-domain.vercel.app
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret
LEMONSQUEEZY_PLAN_1M_URL=https://yourstore.lemonsqueezy.com/checkout/buy/...
LEMONSQUEEZY_PLAN_3M_URL=https://yourstore.lemonsqueezy.com/checkout/buy/...
LEMONSQUEEZY_PLAN_6M_URL=https://yourstore.lemonsqueezy.com/checkout/buy/...
CRON_SECRET=your_cron_secret
REPORT_TZ=Asia/Almaty
IMGBB_API_KEY=your_imgbb_api_key
CREATOMATE_API_KEY=your_creatomate_api_key
FB_PAGE_ID=your_facebook_page_id
PHOTOROOM_API_KEY=your_photoroom_api_key
# Make.com webhook URL — создай сценарий в Make и вставь URL вебхука сюда
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxxxx
